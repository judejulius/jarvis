<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">

    <TextView
        style="@style/Jarvis.Section"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/section_assistant"
        tools:ignore="HardcodedText" />

    <com.google.android.material.card.MaterialCardView
        style="@style/Jarvis.Card"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/which_ai"
                android:textColor="@color/text"
                tools:ignore="HardcodedText" />

            <com.google.android.material.chip.ChipGroup
                android:id="@+id/aiModeChips"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:selectionRequired="true"
                app:singleSelection="true" />

            <TextView
                android:id="@+id/aiModeHint"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="@color/text_dim"
                android:textSize="12sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:text="@string/voice_command_language"
                android:textColor="@color/text"
                tools:ignore="HardcodedText" />

            <com.google.android.material.chip.ChipGroup
                android:id="@+id/speechLangChips"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:selectionRequired="true"
                app:singleSelection="true" />

            <TextView
                android:id="@+id/speechLangHint"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="@color/text_dim"
                android:textSize="12sp" />

            <com.google.android.material.materialswitch.MaterialSwitch
                android:id="@+id/confirmSwitch"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:text="@string/confirm_sensitive"
                android:textColor="@color/text"
                tools:ignore="HardcodedText" />

            <com.google.android.material.materialswitch.MaterialSwitch
                android:id="@+id/shareMemorySwitch"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/share_memory_cloud"
                android:textColor="@color/text"
                tools:ignore="HardcodedText" />

            <com.google.android.material.materialswitch.MaterialSwitch
                android:id="@+id/autoStartSwitch"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/autostart_local_model"
                android:textColor="@color/text"
                tools:ignore="HardcodedText" />

            <TextView
                android:id="@+id/localStatus"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:textColor="@color/text_dim"
                android:textSize="12sp" />

            <com.google.android.material.materialswitch.MaterialSwitch
                android:id="@+id/rememberTasksSwitch"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/remember_tasks"
                android:textColor="@color/text"
                tools:ignore="HardcodedText" />

            <com.google.android.material.materialswitch.MaterialSwitch
                android:id="@+id/embeddedSwitch"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:text="@string/use_embedded_model"
                android:textColor="@color/text"
                tools:ignore="HardcodedText" />

            <com.google.android.material.materialswitch.MaterialSwitch
                android:id="@+id/mobileDownloadSwitch"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/allow_mobile_data_download"
                android:textColor="@color/text"
                tools:ignore="HardcodedText" />

            <TextView
                android:id="@+id/runtimeStatus"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:textColor="@color/text_dim"
                android:textSize="12sp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/runtimeButton"
                style="@style/Widget.Material3.Button.TonalButton"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="10dp"
                android:text="@string/download_embedded_model"
                app:cornerRadius="12dp"
                tools:ignore="HardcodedText" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/permissionsButton"
                style="@style/Widget.Material3.Button.TonalButton"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="10dp"
                android:text="@string/allow_contacts"
                app:cornerRadius="12dp"
                tools:ignore="HardcodedText" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/memoriesButton"
                style="@style/Widget.Material3.Button.TonalButton"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="10dp"
                android:text="@string/memories"
                app:cornerRadius="12dp"
                tools:ignore="HardcodedText" />
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>
</LinearLayout>
