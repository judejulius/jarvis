<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">

    <TextView
        style="@style/Jarvis.Section"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Assistant"
        tools:ignore="HardcodedText" />

    <com.google.android.material.card.MaterialCardView
        style="@style/Jarvis.Card"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Which AI answers"
                android:textColor="@color/text"
                tools:ignore="HardcodedText" />

            <com.google.android.material.chip.ChipGroup
                android:id="@+id/aiModeChips"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:selectionRequired="true"
                app:singleSelection="true" />

            <TextView
                android:id="@+id/aiModeHint"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="@color/text_dim"
                android:textSize="12sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:text="Voice command language"
                android:textColor="@color/text"
                tools:ignore="HardcodedText" />

            <com.google.android.material.chip.ChipGroup
                android:id="@+id/speechLangChips"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:selectionRequired="true"
                app:singleSelection="true" />

            <TextView
                android:id="@+id/speechLangHint"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="@color/text_dim"
                android:textSize="12sp" />

            <com.google.android.material.materialswitch.MaterialSwitch
                android:id="@+id/confirmSwitch"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:text="Ask before calls and messages"
                android:textColor="@color/text"
                tools:ignore="HardcodedText" />

            <com.google.android.material.materialswitch.MaterialSwitch
                android:id="@+id/shareMemorySwitch"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Let cloud AI see my memories"
                android:textColor="@color/text"
                tools:ignore="HardcodedText" />

            <com.google.android.material.materialswitch.MaterialSwitch
                android:id="@+id/autoStartSwitch"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Start the on-phone model automatically"
                android:textColor="@color/text"
                tools:ignore="HardcodedText" />

            <TextView
                android:id="@+id/localStatus"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:textColor="@color/text_dim"
                android:textSize="12sp" />

            <com.google.android.material.materialswitch.MaterialSwitch
                android:id="@+id/rememberTasksSwitch"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Remember what tasks I have done"
                android:textColor="@color/text"
                tools:ignore="HardcodedText" />

            <com.google.android.material.materialswitch.MaterialSwitch
                android:id="@+id/embeddedSwitch"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:text="Use the on-device model built into Jarvis"
                android:textColor="@color/text"
                tools:ignore="HardcodedText" />

            <com.google.android.material.materialswitch.MaterialSwitch
                android:id="@+id/mobileDownloadSwitch"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Allow the model download on mobile data"
                android:textColor="@color/text"
                tools:ignore="HardcodedText" />

            <TextView
                android:id="@+id/runtimeStatus"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:textColor="@color/text_dim"
                android:textSize="12sp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/runtimeButton"
                style="@style/Widget.Material3.Button.TonalButton"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="10dp"
                android:text="Download on-device model"
                app:cornerRadius="12dp"
                tools:ignore="HardcodedText" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/permissionsButton"
                style="@style/Widget.Material3.Button.TonalButton"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="10dp"
                android:text="Allow contacts and calling"
                app:cornerRadius="12dp"
                tools:ignore="HardcodedText" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/memoriesButton"
                style="@style/Widget.Material3.Button.TonalButton"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="10dp"
                android:text="Memories"
                app:cornerRadius="12dp"
                tools:ignore="HardcodedText" />
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>
</LinearLayout>
